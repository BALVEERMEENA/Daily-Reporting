rules_version = '2';

// Access control for the Daily Reporting app. With no backend server, these
// rules ARE the security model.
//
// Model:
//  - A "user" is a person. Managers (admin/dept_head) and any employee you give
//    a login to have a Firebase Auth account, and their users/{uid} doc is keyed
//    by that auth uid. Report-only employees have a users/{autoId} doc and no
//    login.
//  - Every user has a unique reporting id (admin-chosen). codes/{uniqueId} is a
//    public-by-id lookup mapping that id to the user and the questionnaires
//    assigned to them, so an employee can report by typing only their id.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() { return request.auth != null; }
    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function isDeptHead() { return hasProfile() && me().role == 'dept_head'; }
    function isManager() { return isAdmin() || isDeptHead(); }
    function myDept() { return me().departmentId; }
    function deptOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.departmentId;
    }
    function codeData(id) {
      return get(/databases/$(database)/documents/codes/$(id)).data;
    }
    function assignmentData(id) {
      return get(/databases/$(database)/documents/assignments/$(id)).data;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Fields a task's assignee (or a report-by-code update) may change.
    function progressOnly() {
      return changedKeys().hasOnly(
        ['status', 'oneTimeStatus', 'pendingReason', 'completedDate', 'pendency', 'updatedAt']);
    }

    // ---- users ----
    // Login users are keyed by their auth uid, so a user can read their own doc.
    // Report-only users are never read by rules (they don't sign in).
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (isDeptHead() && resource.data.departmentId == myDept())
      );
      allow create: if isAdmin() || (
        isDeptHead() &&
        request.resource.data.role == 'employee' &&
        request.resource.data.departmentId == myDept()
      );
      allow update: if isAdmin() || (
        request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.departmentId == resource.data.departmentId
      );
      allow delete: if isAdmin() || (isDeptHead() && resource.data.departmentId == myDept());
    }

    // ---- departments ----
    match /departments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- questionnaires ----
    // A single questionnaire is world-readable by exact id so the public code
    // flow can load its questions; enumeration (list) stays manager-only.
    match /questionnaires/{id} {
      allow get: if true;
      allow list: if isAdmin() || (isDeptHead() && resource.data.departmentId == myDept());
      allow create: if isManager() &&
        request.resource.data.createdBy == request.auth.uid &&
        (isAdmin() || request.resource.data.departmentId == myDept());
      allow update, delete: if isAdmin() ||
        (isDeptHead() && resource.data.departmentId == myDept()) ||
        (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ---- codes ----  (doc id == the user's unique reporting id)
    // Readable by exact id only (public reporting lookup); no enumeration.
    match /codes/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() ||
        (isDeptHead() && request.resource.data.departmentId == myDept());
      // Managers may manage the code doc; anyone may edit ONLY their own
      // personal schedule (the owner when logged in, or the report-by-code
      // holder when not) — restricted to the `scheduled` field.
      allow update: if isAdmin() ||
        (isDeptHead() && resource.data.departmentId == myDept()) ||
        (changedKeys().hasOnly(['scheduled']) && (
          (request.auth != null && request.auth.uid == resource.data.userId) ||
          request.auth == null));
      allow delete: if isAdmin() ||
        (isDeptHead() && resource.data.departmentId == myDept());
    }

    // ---- assignments ----  (links a questionnaire to a user)
    match /assignments/{id} {
      allow read: if isAdmin() || (isDeptHead() && resource.data.departmentId == myDept());
      allow create: if isAdmin() || (
        isDeptHead() &&
        request.resource.data.departmentId == myDept() &&
        deptOf(request.resource.data.userId) == myDept()
      );
      allow update, delete: if isAdmin() ||
        (isDeptHead() && resource.data.departmentId == myDept());
    }

    // ---- submissions ----
    // Created by the (possibly anonymous) reporting flow, but only when the
    // payload matches a real code and an active assignment for that user.
    match /submissions/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        (isDeptHead() && resource.data.departmentId == myDept())
      );
      allow create: if
        request.resource.data.submittedAt == request.time &&
        request.resource.data.answers is list &&
        exists(/databases/$(database)/documents/codes/$(request.resource.data.uniqueId)) &&
        codeData(request.resource.data.uniqueId).userId == request.resource.data.userId &&
        exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)) &&
        assignmentData(request.resource.data.assignmentId).active == true &&
        assignmentData(request.resource.data.assignmentId).userId == request.resource.data.userId &&
        assignmentData(request.resource.data.assignmentId).questionnaireId == request.resource.data.questionnaireId &&
        request.resource.data.departmentId == assignmentData(request.resource.data.assignmentId).departmentId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- tasks ----
    // Readable by exact id so the public reporting flow can show a person's
    // tasks; listing (dashboard) is limited to managers and the assignee.
    match /tasks/{id} {
      allow get: if true;
      allow list: if isSignedIn() && (
        isAdmin() ||
        (isDeptHead() && resource.data.departmentId == myDept()) ||
        resource.data.assignedTo == request.auth.uid
      );
      allow create: if isManager() &&
        request.resource.data.assignedBy == request.auth.uid &&
        (isAdmin() || (
          request.resource.data.departmentId == myDept() &&
          deptOf(request.resource.data.assignedTo) == myDept()
        ));
      // Managers edit freely. The assignee (logged in) or a report-by-code
      // update (unauthenticated, gated on the task's code existing) may change
      // only progress fields.
      allow update: if isAdmin() ||
        (isDeptHead() && resource.data.departmentId == myDept()) ||
        (resource.data.assignedTo == request.auth.uid && progressOnly()) ||
        (request.auth == null &&
          exists(/databases/$(database)/documents/codes/$(resource.data.assignedUniqueId)) &&
          progressOnly());
      allow delete: if isAdmin() || (isDeptHead() && resource.data.departmentId == myDept());
    }

    // ---- taskUpdates ----  (append-only audit log of each change)
    match /taskUpdates/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isDeptHead() && resource.data.departmentId == myDept()) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() ||
        (request.auth == null &&
          exists(/databases/$(database)/documents/codes/$(request.resource.data.uniqueId)));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- notifications ----
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        changedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
