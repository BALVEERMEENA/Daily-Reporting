rules_version = '2';

// Access control for the Daily Reporting app. With no backend server, these
// rules ARE the security model.
//
// Hierarchy (Stage B): every department stores a materialized `path` (its
// ancestor ids, root-first, including itself). Dept-scoped records copy that
// as `deptPath`. A department head may act on any record whose deptPath
// contains their own department id — i.e. their own department and every
// sub-department beneath it. Admins can do everything.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() { return request.auth != null; }
    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function isDeptHead() { return hasProfile() && me().role == 'dept_head'; }
    function isManager() { return isAdmin() || isDeptHead(); }
    function myDept() { return me().departmentId; }
    function codeData(id) {
      return get(/databases/$(database)/documents/codes/$(id)).data;
    }
    function assignmentData(id) {
      return get(/databases/$(database)/documents/assignments/$(id)).data;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function progressOnly() {
      return changedKeys().hasOnly(
        ['status', 'oneTimeStatus', 'pendingReason', 'completedDate', 'pendency', 'updatedAt',
         'lastRemark', 'lastRemarkDate', 'lastTable', 'lastTableDate']);
    }
    // Admin, or a department head whose department is an ancestor of (or equal
    // to) the record's department. `data` is resource.data or request.resource.data.
    function scoped(data) {
      return isAdmin() ||
        (isDeptHead() && data.keys().hasAny(['deptPath']) && (myDept() in data.deptPath));
    }
    // Admin, or a head STRICTLY above the record's department (a superior) —
    // used for approving another department's questionnaire changes.
    function strictSuperior(data) {
      return isAdmin() ||
        (isDeptHead() && data.keys().hasAny(['deptPath']) &&
          (myDept() in data.deptPath) && myDept() != data.departmentId);
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || scoped(resource.data));
      // Heads may add employees or sub-heads anywhere in their subtree, but
      // never admins.
      allow create: if isAdmin() || (
        isDeptHead() &&
        request.resource.data.role != 'admin' &&
        scoped(request.resource.data)
      );
      allow update: if isAdmin() ||
        (request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.departmentId == resource.data.departmentId) ||
        (isDeptHead() && scoped(resource.data) && scoped(request.resource.data) &&
          request.resource.data.role != 'admin');
      allow delete: if isAdmin() || (isDeptHead() && scoped(resource.data));
    }

    // ---- departments ----
    // Admins manage the whole tree. A department head has admin-level rights
    // *within their subtree*: they may create sub-departments under it and
    // edit/delete departments strictly below their own (never their own
    // department or an ancestor, and never move one out of the subtree).
    match /departments/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin() ||
        (isDeptHead() && request.resource.data.keys().hasAny(['path']) &&
          (myDept() in request.resource.data.path));
      allow update: if isAdmin() ||
        (isDeptHead() && id != myDept() &&
          resource.data.keys().hasAny(['path']) && (myDept() in resource.data.path) &&
          request.resource.data.keys().hasAny(['path']) && (myDept() in request.resource.data.path));
      allow delete: if isAdmin() ||
        (isDeptHead() && id != myDept() &&
          resource.data.keys().hasAny(['path']) && (myDept() in resource.data.path));
    }

    // ---- questionnaires ----
    // Creation is scoped (a head can create in their subtree). Editing/deleting
    // an existing questionnaire directly is limited to an admin or a STRICT
    // superior of the questionnaire's department — the owning department's head
    // must instead file an approval request (see /approvals).
    match /questionnaires/{id} {
      allow get: if true;
      allow list: if scoped(resource.data);
      allow create: if isManager() &&
        request.resource.data.createdBy == request.auth.uid &&
        scoped(request.resource.data);
      allow update, delete: if strictSuperior(resource.data);
    }

    // ---- approvals ----  (questionnaire change requests awaiting a superior)
    match /approvals/{id} {
      allow read: if scoped(resource.data);
      allow create: if isDeptHead() &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        scoped(request.resource.data);
      // Only a superior (or admin) may resolve a still-pending request, and only
      // by setting the resolution fields.
      allow update: if resource.data.status == 'pending' &&
        changedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']) &&
        strictSuperior(resource.data);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.requestedBy == request.auth.uid);
    }

    // ---- codes ----  (doc id == the user's unique reporting id)
    match /codes/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if scoped(request.resource.data);
      // Managers may manage the code doc; the owner (logged in) or the
      // report-by-code holder (anonymous) may edit ONLY their personal
      // schedule and their replies to manager observations.
      allow update: if scoped(resource.data) ||
        (changedKeys().hasOnly(['scheduled', 'observations']) && (
          (request.auth != null && request.auth.uid == resource.data.userId) ||
          request.auth == null));
      allow delete: if scoped(resource.data);
    }

    // ---- assignments ----  (links a questionnaire to a user)
    match /assignments/{id} {
      allow read: if scoped(resource.data);
      allow create: if scoped(request.resource.data);
      allow update, delete: if scoped(resource.data);
    }

    // ---- submissions ----
    // Created by the (possibly anonymous) reporting flow, but only when the
    // payload matches a real code and an active assignment for that user.
    // New reports use a deterministic id `${assignmentId}__${reportDate}` so
    // there is exactly one report per person + questionnaire + date, and the
    // code holder can find, overwrite (Modify) or delete their own.
    function submissionValid(data) {
      return data.answers is list &&
        data.reportDate is string &&
        exists(/databases/$(database)/documents/codes/$(data.uniqueId)) &&
        codeData(data.uniqueId).userId == data.userId &&
        data.deptPath == codeData(data.uniqueId).deptPath &&
        exists(/databases/$(database)/documents/assignments/$(data.assignmentId)) &&
        assignmentData(data.assignmentId).active == true &&
        assignmentData(data.assignmentId).userId == data.userId &&
        assignmentData(data.assignmentId).questionnaireId == data.questionnaireId;
    }
    match /submissions/{id} {
      // Single-doc reads: the id embeds the random assignmentId, so only the
      // code holder (or a manager who has the record) can construct it.
      allow get: if true;
      // Queries stay restricted to the owner and managers in scope.
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || scoped(resource.data)
      );
      allow create: if request.resource.data.submittedAt == request.time &&
        submissionValid(request.resource.data);
      // Overwrite (Modify) an existing report, keeping identity + date fixed.
      allow update: if request.resource.data.submittedAt == request.time &&
        submissionValid(request.resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.assignmentId == resource.data.assignmentId &&
        request.resource.data.reportDate == resource.data.reportDate;
      // A manager in scope deletes freely. The anonymous reporting surface may
      // also delete a report (it must already know the unguessable doc id,
      // which embeds the random assignmentId — i.e. it holds the code).
      allow delete: if scoped(resource.data) ||
        (request.auth == null &&
          exists(/databases/$(database)/documents/codes/$(resource.data.uniqueId)));
    }

    // ---- tasks ----
    match /tasks/{id} {
      allow get: if true;
      allow list: if scoped(resource.data) || (isSignedIn() && resource.data.assignedTo == request.auth.uid);
      allow create: if isManager() &&
        request.resource.data.assignedBy == request.auth.uid &&
        scoped(request.resource.data);
      // Managers (in scope) edit freely. The assignee (logged in) or a
      // report-by-code update may change only progress fields.
      allow update: if scoped(resource.data) ||
        (isSignedIn() && resource.data.assignedTo == request.auth.uid && progressOnly()) ||
        (request.auth == null &&
          exists(/databases/$(database)/documents/codes/$(resource.data.assignedUniqueId)) &&
          progressOnly());
      allow delete: if scoped(resource.data);
    }

    // ---- taskUpdates ----  (append-only audit log of each change)
    match /taskUpdates/{id} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || scoped(resource.data)
      );
      allow create: if isSignedIn() ||
        (request.auth == null &&
          exists(/databases/$(database)/documents/codes/$(request.resource.data.uniqueId)));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- settings ----  (shared config, e.g. the Business Report mapping)
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // ---- exemptions ----  (a staff member excused from reporting on a date)
    match /exemptions/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManager();
    }

    // ---- notifications ----
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        changedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
