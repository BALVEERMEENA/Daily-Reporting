# Copy to .env and adjust. All values are optional — sensible defaults apply.

# HTTP port
PORT=3000

# Secret used to sign login tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h

# Bootstrap admin account created on first run (empty database only).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Where the SQLite database file lives.
# DATA_DIR=./data
# DB_PATH=./data/reporting.db
